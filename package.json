{
  "name": "@local/dsh-model-leaderboard",
  "version": "1.0.0",
  "private": true,
  "description": "Live OpenRouter model rankings in the DSH sidebar: quality indices, head-to-head Elo, usage, and per-million-token prices, with one click to set the default model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yczhang1028/dsh-model-leaderboard.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "openrouter",
    "llm",
    "leaderboard",
    "pricing"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
